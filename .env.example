# ==============================================================================
# HỆ THỐNG CỔNG THÔNG TIN EASUPSO.COM — BIẾN MÔI TRƯỜNG MẪU (ENV TEMPLATE)
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env THỰC TẾ LÊN HỆ THỐNG QUẢN LÝ PHIÊN BẢN (GIT)
# CÁC MẬT KHẨU PHẢI ĐƯỢC SINH BẰNG BITWARDEN GENERATOR (ĐỘ DÀI TỐI THIỂU 32 KÝ TỰ)
# ==============================================================================

# --- 1. CẤU HÌNH CƠ SỞ DỮ LIỆU POSTGRESQL (NỘI BỘ DOCKER) ---
# Tên Database nội bộ
DB_NAME=easupso_portal
# Tài khoản quản trị database
DB_USER=easupso_admin
# Mật khẩu PostgreSQL: Sinh từ Bitwarden Password Generator (32 ký tự ngẫu nhiên bao gồm chữ hoa, chữ thường, số)
DB_PASSWORD=BW_GEN_32_CHARS_EXAMPLE_Abc123XyZ!987654321
# Chuỗi kết nối Prisma ORM kết nối tới service container nội bộ 'easupso_portal_db' (Port 5432 chỉ mở nội bộ trong Docker Network)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@easupso_portal_db:5432/${DB_NAME}?schema=public"

# --- 2. CẤU HÌNH BẢO MẬT XÁC THỰC (NEXTAUTH / ZERO-TRUST SSO) ---
# Khóa bí mật mã hóa JWT/Session: Sinh từ Bitwarden Generator (32+ ký tự ngẫu nhiên bảo mật cao)
AUTH_SECRET=BW_GEN_32_CHARS_AUTH_SECRET_KEY_987654321
NEXTAUTH_SECRET=BW_GEN_32_CHARS_AUTH_SECRET_KEY_987654321
NEXTAUTH_URL=https://easupso.com

# --- 3. ĐỊNH DANH GOOGLE OAUTH 2.0 (GOOGLE CLOUD CONSOLE) ---
# Được cấp từ Google Cloud Console cho miền easupso.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- 4. CẤU HÌNH CÁC PHÂN HỆ HỆ SINH THÁI CHUYỂN ĐỔI SỐ XÃ EA SÚP ---
NEXT_PUBLIC_PORTAL_URL=https://easupso.com
NEXT_PUBLIC_LICHCONGTAC_URL=https://lichcongtac.easupso.com
NEXT_PUBLIC_YKIEN_URL=https://ykien.easupso.com
NEXT_PUBLIC_NONGNGHIEP_URL=https://nongnghiep.easupso.com
NEXT_PUBLIC_DULICH_URL=https://dulich.easupso.com
NEXT_PUBLIC_CCB_URL=https://ccb.easupso.com
NEXT_PUBLIC_VINGUOINGHEO_URL=https://vinguoingheo.easupso.com

# --- 5. CẤU HÌNH THÔNG TIN LIÊN HỆ & THƯ HỆ THỐNG ---
NEXT_PUBLIC_HOTLINE="0943 170 770"
SMTP_FROM=noreply@easupso.com
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@easupso.com
# Mật khẩu SMTP sinh từ Bitwarden Generator (32 ký tự)
SMTP_PASSWORD=BW_GEN_32_CHARS_SMTP_PASSWORD_Xyz123

# --- 6. MÔI TRƯỜNG THỰC THI ---
NODE_ENV=production
PORT=3000
